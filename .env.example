# Admin panel (/admin) credentials
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: secret for signing the session cookie (falls back to ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=

# Upstash Redis — added automatically when you add the Upstash Redis integration
# from the Vercel Marketplace (Project -> Storage). Leave empty locally to use memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
