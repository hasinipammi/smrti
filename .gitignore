# ---------- dependencies ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# ---------- build output ----------
# .output is the nitro build; .wrangler is generated by the cloudflare deploy step
dist/
dist-ssr/
build/
.output/
.nitro/
.vinxi/
.tanstack/
.wrangler/
.vercel/
.netlify/

# ---------- caches ----------
.vite/
*.tsbuildinfo
.eslintcache
.cache/
.temp/
.tmp/

# ---------- environment ----------
# Never commit real secrets. Commit a .env.example instead.
.env
.env.*
!.env.example
.dev.vars

# ---------- logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- editors ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- os ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- testing ----------
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# NOTE: public/l5e/ is intentionally NOT ignored. Those are the project's
# images and audio, vendored out of Lovable's asset CDN so the app renders
# outside Lovable hosting. Ignoring them makes every image disappear again.
